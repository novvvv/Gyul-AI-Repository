# ── Spring 연동 공유 값 (가이드 §5 — Spring 레포 .env와 동일하게 주입) ──────────
# JWT 서명 시크릿 — Spring과 반드시 동일, 32바이트 이상. 불일치 시 모든 토큰 검증 실패.
JWT_SECRET=change-me-to-shared-secret-with-spring-32bytes-min
# Kafka 브로커 (Spring 레포 docker-compose 기준 localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Redis — FastAPI는 DB 0 고정 (DB 1은 Spring Refresh Token 저장소, 접근 금지)
REDIS_URL=redis://localhost:6379/0

# ── 대화 세션 메모리 ─────────────────────────────────────────────────────────
# memory(프로세스 메모리) | redis (운영 권장 — 계약 §4)
MEMORY_BACKEND=memory
SESSION_MEMORY_TTL_SECONDS=86400
SESSION_MEMORY_MAX_TURNS=20

# ── Kafka 리포트 발행 ────────────────────────────────────────────────────────
ENABLE_KAFKA=1
KAFKA_REPORT_TOPIC=interview.analysis-report

# ── LLM ─────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY 있으면 OpenAI, 없으면 Kanana 로컬 폴백
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
GEMINI_MODEL=gemini-2.5-flash
KANANA_MODEL_ID=kakaocorp/kanana-1.5-2.1b-instruct-2505
LOCAL_LLM_MODEL_ID=
LOCAL_LLM_MAX_NEW_TOKENS=256
LOCAL_LLM_TEMPERATURE=0.7

# ── SER / VAD ───────────────────────────────────────────────────────────────
GYUL_MODEL_DIR=model
GYUL_TARGET_SR=16000
GYUL_MIN_CHUNK_SECONDS=1.0
GYUL_VAD_RMS_THRESHOLD=0.01
GYUL_VAD_MIN_SPEECH_SECONDS=0.4
GYUL_VAD_SILENCE_SECONDS=0.7

# ── 얼굴 감정 (vision) ──────────────────────────────────────────────────────
ENABLE_FACE=1
FACE_MODEL_ID=trpakov/vit-face-expression

# ── Fish Audio TTS ──────────────────────────────────────────────────────────
ENABLE_FISH_TTS=1
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=7f92f8afb8ec43bf81429cc1c9199cb1
FISH_AUDIO_MODEL=s2-pro

# OpenAI TTS (낭독). Whisper(audio/transcriptions)는 STT이므로 별개다.
# ENABLE_OPENAI_TTS=1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=shimmer   # alloy · echo · nova · shimmer · sage · coral
